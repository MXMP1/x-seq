# --- Node / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/
.yarn/
package-lock.json.bak

# --- Сборка и локальные артефакты ---
dist/
dist-ssr/
build/
out/
*.local
.cache/
.vite/

# --- Переменные окружения и секреты ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Логи и временные файлы ---
logs/
*.log
*.tmp
*.bak
*.orig
*.swp
*.swo
*~

# --- ОС-мусор ---
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.directory
.Trash-*

# --- Редакторы / IDE ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml
.qoder/

# --- Termux (сервер на телефоне) ---
# Termux хранит всё в $HOME; сюда попадают только локальные копии, если вдруг
termux-logs/
*.sock

# --- Аудио: пользовательские эксперименты ---
# Библиотека library/ коммитится (это ассеты проекта), но локальные
# экспериментальные файлы с суффиксом .local.* — нет.
library/**/*.local.*
library/**/_tmp/

# --- Покрытие тестов и отчёты ---
coverage/
.nyc_output/
test-results/

# --- Локальные референсы, не часть проекта ---
# example-seq — старый PC-секвенсор, лежит рядом только как источник идей
# (микшер с mute/solo/volume, декларативные параметры для MIDI Learn,
# сохранение в localStorage). В репозиторий не должен попадать.
/example-seq/
